# Copia este archivo como .env y rellena los valores.

# Base de datos (PostgreSQL). En producción: la de Supabase (región UE).
DATABASE_URL=postgres://postgres@localhost:5432/adela_dev

# Base de datos aparte para las pruebas automáticas. Se borra en cada ejecución.
DATABASE_URL_TEST=postgres://postgres@localhost:5432/adela_test

# Primer administrador, creado por `pnpm db:seed` si no existe ninguno.
ADMIN_NOMBRE=Adela
ADMIN_USUARIO=adela
ADMIN_CONTRASENA=cambia-esta-contrasena
ADMIN_PIN=2468

# Minutos sin actividad antes de cerrar la sesión.
SESION_MINUTOS_INACTIVIDAD=15
