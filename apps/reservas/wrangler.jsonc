// Configuración de Cloudflare. El id de la base de datos lo pone el despliegue (scripts/desplegar.mjs);
// para probar en local vale cualquiera.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adela-reservas",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "ORIGEN_WEB": "https://adelamariatorremejia.es,https://www.adelamariatorremejia.es,https://especaba66-pixel.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adela-reservas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migraciones"
    }
  ],
  // La web de clientas también se sirve desde aquí (la misma que en GitHub Pages): en reservas.adelamariatorremejia.es
  // la web y el servicio comparten dirección, y el navegador de Instagram no bloquea las peticiones. /api/* va al
  // servicio; lo demás, a los archivos de la web (la publicación la genera antes en apps/landing/dist).
  "assets": { "directory": "../landing/dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true }
}
