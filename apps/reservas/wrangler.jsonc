// Configuración de Cloudflare. El id de la base de datos lo pone el despliegue (scripts/desplegar.mjs);
// para probar en local vale cualquiera.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adela-reservas",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": { "ORIGEN_WEB": "https://especaba66-pixel.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adela-reservas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migraciones"
    }
  ],
  "observability": { "enabled": true }
}
