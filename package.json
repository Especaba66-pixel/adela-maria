{
  "name": "adela-maria",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @adela/web dev",
    "build": "pnpm --filter @adela/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @adela/db generate",
    "db:migrate": "pnpm --filter @adela/db migrate",
    "db:seed": "pnpm --filter @adela/db seed"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "typescript": "5.9.3"
  }
}
